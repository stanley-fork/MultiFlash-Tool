<ui:FluentWindow x:Class="FastbootTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

        xmlns:local="clr-namespace:FastbootTool"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="NekoTool" Height="710" Width="950" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <local:IndexToVisibilityConverter x:Key="IndexToVisibilityConverter"/>
            <local:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter"/>

            <!-- [修复] 无头 TabControl 样式 (隐藏顶部标签栏) -->
            <Style x:Key="HeadlessTabControl" TargetType="TabControl">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- TabControl 样式（无关闭按钮） -->
            <Style TargetType="TabControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Margin="0,0,2,0">
                                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" Margin="8,4"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#C0FFFFFF"/>
                                                <Setter Property="Panel.ZIndex" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- [修复] 自定义 ProgressBar 样式：缩短 IsIndeterminate 模式下的滚动条宽度 (WPF-UI 默认200px太长) -->
            <Style x:Key="ShortIndeterminateProgressBar" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Style.Triggers>
                    <Trigger Property="IsIndeterminate" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ProgressBar}">
                                    <Grid Name="TemplateRoot" ClipToBounds="True">
                                        <Border Margin="1" Background="{DynamicResource ProgressBarIndeterminateBackground}" BorderBrush="{DynamicResource ProgressBarIndeterminateBackground}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                                        <Rectangle Name="PART_Track" Margin="1"/>
                                        <Decorator Name="PART_Indicator" Margin="1" HorizontalAlignment="Left">
                                            <Grid Name="Animation" ClipToBounds="True">
                                                <Border Name="PART_GlowRect" Width="35" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                                            </Grid>
                                        </Decorator>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 全窗口壁纸背景 -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="1"/>
        <Rectangle x:Name="GlassOverlay" RadiusX="0" RadiusY="0">
            <Rectangle.Fill>
                <SolidColorBrush Color="#F0F4F8" Opacity="0.82"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 内容层 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏背景 - 半透明深色让文字可见 -->
            <Border Grid.Row="0" Height="32">
                <Border.Background>
                    <SolidColorBrush Color="#87b1e3" Opacity="0.85"/>
                </Border.Background>
            </Border>

            <!-- 标题栏内容 -->
            <Grid Grid.Row="0" Height="32" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 图标和标题 - 圆角图标 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Grid Width="20" Height="20" Margin="0,0,8,0">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,20,20" RadiusX="4" RadiusY="4"/>
                        </Grid.Clip>
                        <Image Source="icon.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock x:Name="TitleTextBlock" Text="NekoTool" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <!-- 中间可拖动区域 -->
                <Border Grid.Column="1" Background="Transparent"/>

                <!-- 右侧用户按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button x:Name="UserInfoButton" Content="" Appearance="Transparent" Foreground="White" Margin="0,0,4,0" Padding="6,2" Cursor="Hand" ToolTip="点击显示收款码" Click="UserInfoButton_Click"/>
                    <ui:Button x:Name="WallpaperButton" Content="壁纸" Appearance="Transparent" Foreground="White" Margin="0,0,4,0" Padding="6,2" Cursor="Hand" ToolTip="左键随机壁纸，右键自选壁纸" Click="ChangeWallpaper_Click" MouseRightButtonUp="ClearWallpaper_Click"/>
                    <ui:Button x:Name="AboutButton" Content="关于作者" Appearance="Transparent" Foreground="White" Padding="6,2" Cursor="Hand" ToolTip="关于 NekoAdbFBVEtool" Click="AboutButton_Click"/>
                </StackPanel>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="─" Width="46" Height="32" Click="MinimizeButton_Click" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand"/>
                    <Button x:Name="MaxRestoreButton" Content="☐" Width="46" Height="32" Click="MaximizeButton_Click" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand"/>
                    <Button Content="✕" Width="46" Height="32" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 主内容区域 (重构为侧边栏布局) -->
            <Border Grid.Row="1" x:Name="MainBorder" CornerRadius="0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 左侧固定导航栏 (默认收起) -->
                        <ColumnDefinition x:Name="SidebarColumn" Width="50"/> 
                        <!-- 右侧内容区域 -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧导航栏 (支持折叠) -->
                    <Border Grid.Column="0" x:Name="SidebarBorder" Background="Transparent" BorderBrush="#30000000" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 顶部：汉堡菜单按钮 + 标题 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,10,8,5">
                                <ui:Button x:Name="SidebarToggleButton" Appearance="Transparent" Padding="8" Click="SidebarToggleButton_Click" ToolTip="收起/展开侧边栏">
                                    <ui:SymbolIcon Symbol="LineHorizontal320"/>
                                </ui:Button>
                                <TextBlock x:Name="SidebarTitle" Text="NekoTool" FontWeight="SemiBold" Foreground="#444" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- 折叠时显示的图标导航栏 - 【问题2修复】显示所有常用工具按钮 -->
                            <ScrollViewer x:Name="CollapsedIconBar" Grid.Row="1" Margin="4,0" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="GlobalHomeButton_Click" ToolTip="主界面" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="Home24"/>
                                    </ui:Button>
                                    <Separator Margin="4,4"/>
                                    <!-- 常用工具 (与展开状态顺序一致) -->
                                    <ui:Button Appearance="Transparent" Padding="10" Click="ScrcpyButton_Click" ToolTip="Scrcpy投屏" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="Phone24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="FileManagerButton_Click" ToolTip="文件管理" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="Folder24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="OpenCmdButton_Click" ToolTip="CMD终端" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="WindowConsole20"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="UnpackPayloadButton_Click" ToolTip="解包 Payload" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="FolderZip24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="DownloadToolButton_Click" ToolTip="多线程下载器" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="ArrowDownload24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="LenovoToolboxButton_Click" ToolTip="联想工具箱" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="Toolbox24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="OPlusOtaToolButton_Click" ToolTip="ROM大全" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="Globe24"/>
                                    </ui:Button>
                                    <Separator Margin="4,4"/>
                                    <!-- 需要下载资源的工具 -->
                                    <ui:Button Appearance="Transparent" Padding="10" Click="BootPatcherButton_Click" ToolTip="Boot修补" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="Wrench24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="FullAutoRootButton_Click" ToolTip="全自动Root" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="Flash24"/>
                                    </ui:Button>
                                    <ui:Button x:Name="EdlToolIconButton" Appearance="Transparent" Padding="10" Click="EdlToolButton_Click" ToolTip="EDL工具" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="PhoneLaptop24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="InstallDriverButton_Click" ToolTip="安装驱动" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="DeveloperBoard24"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent" Padding="10" Click="InstallWinRARButton_Click" ToolTip="安装 WinRAR" HorizontalAlignment="Center" Margin="0,2">
                                        <ui:SymbolIcon Symbol="FolderZip24"/>
                                    </ui:Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 展开时显示的导航内容 -->
                            <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="SidebarContent" Margin="8,5,8,10">
                                    
                                    <!-- 主界面按钮 -->
                                    <ui:Button x:Name="GlobalHomeButton" Content="主界面" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Icon="{ui:SymbolIcon Home24}" Click="GlobalHomeButton_Click" FontSize="14" Padding="10,8"/>

                                    <!-- 工具分类 (可折叠, 默认收起) -->
                                    <Expander x:Name="ToolsExpander" IsExpanded="False" Margin="0,8,0,0">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Wrench24" Margin="0,0,8,0"/>
                                                <TextBlock Text="工具" FontWeight="SemiBold" FontSize="13"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,5,0,0">
                                            <!-- 本地工具 (无需下载) -->
                                            <ui:Button x:Name="ScrcpyButton" Content="Scrcpy投屏" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="ScrcpyButton_Click" Icon="{ui:SymbolIcon Phone24}" Padding="10,8"/>
                                            <ui:Button x:Name="FileManagerButton" Content="文件管理" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="FileManagerButton_Click" Icon="{ui:SymbolIcon Folder24}" Padding="10,8"/>
                                            <ui:Button x:Name="OpenCmdButton" Content="CMD终端" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="OpenCmdButton_Click" Icon="{ui:SymbolIcon WindowConsole20}" Padding="10,8"/>
                                            <ui:Button x:Name="PayloadDumperButton" Content="解包 Payload" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="UnpackPayloadButton_Click" Icon="{ui:SymbolIcon FolderZip24}" Padding="10,8"/>
                                            <ui:Button x:Name="DownloadToolButton" Content="多线程下载器" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="DownloadToolButton_Click" Icon="{ui:SymbolIcon ArrowDownload24}" Padding="10,8"/>
                                            <ui:Button x:Name="LenovoToolboxButton" Content="联想工具箱" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="LenovoToolboxButton_Click" Icon="{ui:SymbolIcon Toolbox24}" Padding="10,8"/>
                                            <ui:Button x:Name="OPlusOtaToolButton" Content="ROM大全" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="OPlusOtaToolButton_Click" Icon="{ui:SymbolIcon ArrowDownload24}" Padding="10,8"/>
                                            
                                            <!-- 需要下载资源的工具 (放在底部) -->
                                            <Separator Margin="0,8"/>
                                            <ui:Button x:Name="BootPatcherButton" Content="Boot修补" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="BootPatcherButton_Click" Icon="{ui:SymbolIcon Wrench24}" Padding="10,8"/>
                                            <ui:Button x:Name="FullAutoRootButton" Content="全自动Root" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Primary" Margin="0,2" Click="FullAutoRootButton_Click" Icon="{ui:SymbolIcon Flash24}" Padding="10,8" ToolTip="自动完成：获取设备信息→查询ROM→解包Boot→修补→刷入"/>
                                            <ui:Button x:Name="EdlToolButton" Content="EDL工具" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="EdlToolButton_Click" Icon="{ui:SymbolIcon PhoneLaptop24}" Padding="10,8"/>
                                            <ui:Button x:Name="InstallDriverButton" Content="安装驱动" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="InstallDriverButton_Click" Icon="{ui:SymbolIcon DeveloperBoard24}" Padding="10,8"/>
                                            <ui:Button x:Name="InstallWinRARButton" Content="安装 WinRAR" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2" Click="InstallWinRARButton_Click" Icon="{ui:SymbolIcon FolderZip24}" Padding="10,8"/>
                                        </StackPanel>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 右侧内容 (使用 Headless TabControl) -->
                    <TabControl Grid.Column="1" Margin="0" x:Name="MainTabControl" SelectedIndex="0" Style="{StaticResource HeadlessTabControl}" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                        <TabItem Header="主界面">
                            <Grid Margin="10" MouseEnter="MainToolGrid_MouseEnter" MouseLeave="MainToolGrid_MouseLeave">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 设备信息栏 -->
                                    <RowDefinition Height="Auto"/> <!-- 操作工具栏 -->
                                    <RowDefinition Height="*"/>    <!-- 分区表格 -->
                                    <RowDefinition Height="Auto"/> <!-- 日志栏 -->
                                    <RowDefinition Height="Auto"/> <!-- 状态栏 -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: 设备选择与信息 -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:Button x:Name="DeviceSelectorButton" Width="200" Height="34" Margin="0,0,8,0" Click="DeviceSelectorButton_Click" Appearance="Secondary" Icon="{ui:SymbolIcon Phone24}">
                                        <ui:Button.Content>
                                            <Grid Width="150">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="DeviceSelectorText" Grid.Column="0" Text="未连接设备" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text=" ▼" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ui:Button.Content>
                                    </ui:Button>
                                    <Popup x:Name="DeviceSelectorPopup" PlacementTarget="{Binding ElementName=DeviceSelectorButton}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                            <ListBox x:Name="DeviceSelectorListBox" MinWidth="280" MaxHeight="300" SelectionChanged="DeviceSelectorListBox_SelectionChanged" Background="Transparent" BorderThickness="0">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,6"/>
                                                        <Setter Property="Margin" Value="2"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                    <ui:Button x:Name="GetDeviceInfoButton" Content="刷新" Appearance="Primary" Background="#0055AA" Margin="0,0,4,0" Click="GetDeviceInfoButton_Click" Icon="{ui:SymbolIcon ArrowSync24}" Height="34"/>
                                    <ui:Button x:Name="SwitchSlotButton" Content="切换槽位" Appearance="Info" Margin="0,0,8,0" Click="SwitchSlotButton_Click" Height="34"/>
                                    <TextBlock x:Name="DeviceInfoTextBlock" VerticalAlignment="Center" Text="未获取" FontSize="13" Foreground="#555"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="6" Padding="5" Margin="0,0,0,10" HorizontalAlignment="Left">
                                    <WrapPanel Orientation="Horizontal" MaxWidth="750">
                                        <!-- 分区操作 -->
                                        <ui:Button x:Name="RefreshButton" Content="解析分区表" Appearance="Info" Margin="2" Click="RefreshButton_Click" Icon="{ui:SymbolIcon DocumentSearch24}"/>
                                        
                                        <!-- 重启菜单 -->
                                        <Grid Margin="2">
                                            <ui:Button x:Name="RebootButton" Content="重启设备 ▼" Appearance="Info" Click="RebootButton_Click" Icon="{ui:SymbolIcon ArrowSync24}"/>
                                            <Popup x:Name="RebootPopup" PlacementTarget="{Binding ElementName=RebootButton}" StaysOpen="False" AllowsTransparency="True">
                                                <ui:Card Padding="4">
                                                    <StackPanel>
                                                        <ui:Button x:Name="PopupRebootFastbootdButton" Content="重启到 FastbootD" Width="140" Click="RebootFastbootdButton_Click" Appearance="Secondary" Margin="2"/>
                                                        <ui:Button x:Name="PopupRebootBootloaderButton" Content="重启到 Bootloader" Width="140" Click="RebootBootloaderButton_Click" Appearance="Secondary" Margin="2"/>
                                                        <ui:Button x:Name="PopupRebootRecoveryButton" Content="重启到 Recovery" Width="140" Click="RebootRecoveryButton_Click" Appearance="Secondary" Margin="2"/>
                                                        <ui:Button x:Name="PopupRebootSystemButton" Content="重启到系统" Width="140" Click="RebootSystemButton_Click" Appearance="Secondary" Margin="2"/>
                                                        <ui:Button x:Name="PopupRebootEDLButton" Content="重启到EDL" Width="140" Click="RebootEDLButton_Click" Appearance="Secondary" Margin="2"/>
                                                    </StackPanel>
                                                </ui:Card>
                                            </Popup>
                                        </Grid>
                                        
                                        <Border Width="1" Height="20" Background="#DDD" Margin="5,0"/>

                                        <!-- 刷机操作 -->
                                        <ui:Button x:Name="FlashAllButton" Content="一键刷写" Appearance="Primary" Background="#0055AA" Margin="2" Click="FlashAllButton_Click" Icon="{ui:SymbolIcon Flash24}"/>
                                        <ui:Button x:Name="XiaomiFlashButton" Content="小米刷写" Appearance="Primary" Background="#0055AA" Margin="2" Click="XiaomiFlashButton_Click" Icon="{ui:SymbolIcon Phone24}"/>
                                        <ui:Button x:Name="AutoFlashButton" Content="一键刷Root" Appearance="Primary" Background="#0055AA" Margin="2" Click="FlashImageAutomatically_Click" Icon="{ui:SymbolIcon LockOpen24}"/>
                                        <ui:Button x:Name="FixFBDButton" Content="修复FBD" Appearance="Info" Margin="2" Click="FixFastbootdButton_Click" Icon="{ui:SymbolIcon Wrench24}"/>
                                        
                                        <Border Width="1" Height="20" Background="#DDD" Margin="5,0"/>
                                        
                                        <!-- 搜索框 -->
                                        <ui:TextBox x:Name="SearchTextBox" Width="180" Margin="2" PlaceholderText="搜索分区..." TextChanged="SearchTextBox_TextChanged"/>
                                        <ui:Button x:Name="SearchButton" Content="搜索" Appearance="Primary" Background="#0055AA" Margin="2" Click="SearchButton_Click" Icon="{ui:SymbolIcon Search24}"/>
                                        
                                        <!-- 更多操作 -->
                                        <ui:Button x:Name="CreateOppoLogicalPartitionsButton" Content="创建欧加逻辑分区" Appearance="Info" Margin="2" Click="CreateOppoLogicalPartitions_Click" ToolTip="创建欧加设备所需的逻辑分区(A/B/A-only)"/>
                                        <ui:Button x:Name="FlashXiaomiPartitionTableButton" Content="修复MI分区表" Appearance="Info" Margin="2" Click="FlashXiaomiPartitionTable_Click" ToolTip="刷写小米设备分区表文件(gpt_both*.bin)，仅适用于高通设备"/>
                                        <ui:Button x:Name="ClearLogButton" Content="清空日志" Appearance="Danger" Margin="2" Click="ClearLogButton_Click" Icon="{ui:SymbolIcon Delete24}" ToolTip="清空当前日志"/>
                                        
                                        <Border Width="1" Height="20" Background="#DDD" Margin="5,0"/>
                                        
                                        <!-- 系统辅助 -->
                                        <ui:Button x:Name="MainOpenDeviceManagerButton" Content="设备管理器" Appearance="Secondary" Margin="2" Click="OpenDeviceManagerButton_Click" Icon="{ui:SymbolIcon Desktop24}" ToolTip="打开Windows设备管理器"/>
                                        <ui:Button x:Name="MainCreateColorfulFolderButton" Content="创建文件夹" Appearance="Secondary" Margin="2" Click="CreateColorfulFolderButton_Click" Icon="{ui:SymbolIcon FolderAdd24}" ToolTip="创建彩色文件夹"/>
                                    </WrapPanel>
                                </Border>

                                <!-- Row 2: 分区表格区域 -->
                                <Grid Grid.Row="2" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 分区表格 -->
                                    <DataGrid x:Name="PartitionGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True" 
                                          AlternatingRowBackground="#D0E8F3FF" RowBackground="#D0FFFFFF" Background="#80FFFFFF"
                                          GridLinesVisibility="Horizontal" BorderBrush="#50CCCCCC" BorderThickness="1" 
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" RowHeight="32" 
                                          RowHeaderWidth="0"
                                          MouseEnter="PartitionGrid_MouseEnter" MouseLeave="PartitionGrid_MouseLeave" PreviewMouseDoubleClick="PartitionGrid_PreviewMouseDoubleClick">
                                        
                                        <DataGrid.Resources>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
                                                <Setter Property="MinWidth" Value="20"/>
                                                <Setter Property="MinHeight" Value="20"/>
                                            </Style>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0EBF5"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E8EEF4"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#333333"/>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <!-- 通用列：选择框 -->
                                            <DataGridTemplateColumn Width="60" MinWidth="60">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox x:Name="SelectAllCheckBox" ToolTip="全选/取消全选" Click="SelectAllCheckBox_Click" HorizontalAlignment="Center"/>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=False, TargetNullValue=False}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 任务队列专用列：操作类型 (初始隐藏) -->
                                            <DataGridTextColumn x:Name="ColOperation" Header="操作" Binding="{Binding Operation, FallbackValue='', TargetNullValue=''}" Width="100" Visibility="Collapsed" FontWeight="Bold"/>

                                            <!-- 通用列：分区名称 -->
                                            <DataGridTextColumn x:Name="ColName" Header="分区名称" Binding="{Binding Name, FallbackValue='', TargetNullValue=''}" Width="150"/>

                                            <!-- 分区表专用列：映射位置 (ADB模式) -->
                                            <DataGridTextColumn x:Name="ColMapping" Header="映射位置" Binding="{Binding Mapping, FallbackValue='', TargetNullValue=''}" Width="*" Visibility="Collapsed"/>

                                            <!-- 分区表专用列：分区大小 -->
                                            <DataGridTextColumn x:Name="ColSize" Header="分区大小" Binding="{Binding Size, FallbackValue='', TargetNullValue=''}" Width="90" Visibility="Visible" SortMemberPath="SizeBytes"/>

                                            <!-- 分区表专用列：动态分区标记 -->
                                            <DataGridTextColumn x:Name="ColDynamic" Header="动态分区" Binding="{Binding IsDynamic, FallbackValue='', TargetNullValue=''}" Width="80" Visibility="Visible"/>

                                            <!-- 任务队列专用列：文件大小 (初始隐藏) -->
                                            <DataGridTextColumn x:Name="ColFileSize" Header="文件大小" Binding="{Binding FileSize, FallbackValue='', TargetNullValue=''}" Width="90" Visibility="Collapsed"/>

                                            <!-- 通用列：刷写文件路径 (显示文件名，悬浮显示完整路径) -->
                                            <DataGridTemplateColumn x:Name="ColFilePath" Header="刷写文件" Width="200">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FilePath, Converter={StaticResource FilePathToFileNameConverter}, FallbackValue='', TargetNullValue=''}" VerticalAlignment="Center" ToolTip="{Binding FilePath, FallbackValue=''}" TextTrimming="CharacterEllipsis" Padding="5,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 任务队列专用列：刷写模式 (初始隐藏) -->
                                            <DataGridTextColumn x:Name="ColFlashMode" Header="刷写模式" Binding="{Binding FlashMode, FallbackValue='', TargetNullValue=''}" Width="90" Visibility="Collapsed">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="ToolTip" Value="双击切换 Bootloader / FastbootD"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FlashMode, FallbackValue=''}" Value="FastbootD">
                                                                <Setter Property="Foreground" Value="#0066CC"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FlashMode, FallbackValue=''}" Value="Bootloader">
                                                                <Setter Property="Foreground" Value="#CC6600"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FlashMode, FallbackValue=''}" Value="N/A">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>

                                            <!-- 任务队列专用列：状态 (初始隐藏) -->
                                            <DataGridTemplateColumn x:Name="ColStatus" Header="状态" Width="60" Visibility="Collapsed">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Status, FallbackValue='', TargetNullValue=''}" 
                                                                   Foreground="{Binding StatusColor, FallbackValue={x:Static Brushes.Black}, TargetNullValue={x:Static Brushes.Black}}" 
                                                                   FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 分区表专用列：选择按钮 -->
                                            <DataGridTemplateColumn x:Name="ColSelectBtn" Header="选择" Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ui:Button Content="选择" Click="SelectFileForPartition_Click" Margin="2" Padding="5,0" VerticalAlignment="Center" Appearance="Secondary"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 右侧竖向操作按钮 -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <StackPanel x:Name="TaskButtonsPanel" Visibility="Collapsed">
                                            <ui:Button x:Name="ExecuteTasksButton" Content="▶ 开始执行" Appearance="Success" Width="100" Margin="0,0,0,8" Click="ExecuteTasksButton_Click" ToolTip="执行列表中的所有任务"/>
                                            <ui:Button x:Name="ReturnButton" Content="↩ 返回列表" Appearance="Secondary" Width="100" Margin="0,0,0,8" Click="ReturnButton_Click" ToolTip="放弃任务并返回设备分区表"/>
                                        </StackPanel>
                                        <StackPanel x:Name="NormalButtonsPanel">
                                            <ui:Button x:Name="FlashSelectedButton" Content="刷写选中" Appearance="Primary" Background="#0055AA" Margin="0,4" Click="FlashSelectedButton_Click" ToolTip="刷写所有选中的分区" Icon="{ui:SymbolIcon ArrowDownload24}"/>
                                            <ui:Button x:Name="ReadbackSelectedButton" Content="回读选中" Appearance="Primary" Background="#0055AA" Margin="0,4" Click="ReadbackSelectedButton_Click" ToolTip="回读所有选中的分区 (仅ADB模式)" Icon="{ui:SymbolIcon ArrowUpload24}"/>
                                            <ui:Button x:Name="EraseSelectedButton" Content="擦除选中" Appearance="Caution" Margin="0,4" Click="EraseSelectedButton_Click" ToolTip="擦除所有选中的分区" Icon="{ui:SymbolIcon Delete24}"/>
                                            <ui:Button x:Name="DeleteSelectedButton" Content="删除选中" Appearance="Danger" Margin="0,4" Click="DeleteSelectedButton_Click" ToolTip="删除所有选中的动态分区 (仅Fastboot模式)" Icon="{ui:SymbolIcon Dismiss24}"/>
                                            <ui:Button x:Name="CreatePartitionButton" Content="新建分区" Appearance="Secondary" Margin="0,4" Click="CreatePartitionButton_Click" ToolTip="新建一个动态分区 (仅Fastboot模式)" Icon="{ui:SymbolIcon Add24}"/>
                                            <ui:Button x:Name="ResizePartitionButton" Content="扩容分区" Appearance="Secondary" Margin="0,4" Click="ResizePartitionButton_Click" ToolTip="调整单个选中分区的大小 (仅Fastboot模式)" Icon="{ui:SymbolIcon Resize24}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: 日志区域 -->
                                <avalonedit:TextEditor Grid.Row="3" x:Name="LogTextBox" Height="120" Margin="0,0,0,5" Padding="5" FontFamily="Consolas" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" WordWrap="True" ShowLineNumbers="True" Visibility="Collapsed" BorderBrush="#50CCCCCC" BorderThickness="1" Background="#80FFFFFF"/>

                                <!-- Row 4: 状态栏 -->
                                <StatusBar Grid.Row="4" Background="#80E0E0E0" Padding="2,0">
                                    <StatusBarItem Padding="0">
                                        <TextBlock x:Name="StatusTextBlock" Text="就绪" Margin="5,2"/>
                                    </StatusBarItem>
                                    <StatusBarItem HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button x:Name="StopOperationButton" Content="停止操作" Appearance="Danger" Visibility="Collapsed" Click="StopOperationButton_Click" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="CancellationStatusText" Text="正在取消操作..." Visibility="Collapsed" Foreground="Red" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <ItemsControl x:Name="DownloadProgressPanel" Margin="5,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ProgressBar x:Name="ProgressBar" Width="100" Height="15" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Style="{StaticResource ShortIndeterminateProgressBar}"/>
                                        </StackPanel>
                                    </StatusBarItem>
                                </StatusBar>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
