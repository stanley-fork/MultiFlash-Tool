<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SakuraEDL</RootNamespace>
    <AssemblyName>SakuraEDL</AssemblyName>
    <ApplicationIcon>SakuraEDL.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>xiri</Company>
    <Authors>xiri</Authors>
    <Product>SakuraEDL</Product>
    <Copyright>Copyright © xiri 2025-2026. All Rights Reserved.</Copyright>
    <Description>多功能安卓刷机工具 - 支持高通/联发科/Fastboot</Description>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 关闭控制流保护(CFG)，避免加壳/加密工具(如 VMProtect 等)处理后无法运行 -->
    <EnableControlFlowGuard>false</EnableControlFlowGuard>
    <!-- 默认排除 Realme 认证（公开/GitHub 构建）。含完整实现时请用 dotnet build -p:ExcludeRealmeAuth=false -->
    <ExcludeRealmeAuth Condition="'$(ExcludeRealmeAuth)'==''">true</ExcludeRealmeAuth>
    <DefineConstants Condition="'$(ExcludeRealmeAuth)'=='true'">$(DefineConstants);EXCLUDE_REALME_AUTH</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FastbootTool\**" />
    <!-- 排除 Realme 认证相关源文件（ExcludeRealmeAuth=true 或默认时生效） -->
    <Compile Condition="'$(ExcludeRealmeAuth)'=='true'" Remove="Qualcomm\Services\RealmeSignService.cs" />
    <Compile Condition="'$(ExcludeRealmeAuth)'=='true'" Remove="Qualcomm\Services\RealmeCloudLoaderService.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.2.10" />
    <PackageReference Include="LibUsbDotNet" Version="2.2.29" />
    <PackageReference Include="SunnyUI" Version="3.9.1" />
    <PackageReference Include="SunnyUI.Common" Version="3.9.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="adb.exe">
      <LogicalName>SakuraEDL.Resources.adb.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="fastboot.exe">
      <LogicalName>SakuraEDL.Resources.fastboot.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="AdbWinApi.dll">
      <LogicalName>SakuraEDL.Resources.AdbWinApi.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="AdbWinUsbApi.dll">
      <LogicalName>SakuraEDL.Resources.AdbWinUsbApi.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Generate exe.config from App.config for ConfigurationManager -->
  <Target Name="CopyAppConfig" AfterTargets="Build">
    <Copy SourceFiles="App.config" DestinationFiles="$(OutputPath)$(AssemblyName).exe.config" SkipUnchangedFiles="true" />
  </Target>

  <!-- 发布后可选运行 UPX（需已安装 UPX 并加入 PATH；.NET 托管 exe 不被 UPX 支持，会跳过） -->
  <Target Name="RunUpxAfterPublish" AfterTargets="Publish" Condition="'$(RunUpx)' == 'true'">
    <PropertyGroup>
      <_UpxPath>upx</_UpxPath>
    </PropertyGroup>
    <Exec Command="&quot;$(_UpxPath)&quot; --best --lzma &quot;$(PublishDir)$(AssemblyName).exe&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
