            <item>
             <widget class="QCheckBox" name="fixGptAfterWriteCheckBox">
              <property name="visible">
               <bool>false</bool>
              </property>
              <property name="toolTip">
               <string>部分 Firehose 对 fixgpt 响应异常会破坏刚写入的 GPT；若其他工具仅写入 GPT 后分区正常，可取消勾选本项后重试。</string>
              </property>
              <property name="text">
