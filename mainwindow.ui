   </property>
   <property name="text">
    <string>重启到 Fastbootd（写 MISC 后重启）</string>
   </property>
   <property name="toolTip">
    <string>将镜像完整写入 misc 分区后发送 power reset。默认使用 misc_tofastbootd.img（程序目录、或编译嵌入 bundled/）；也可在「设置」自定义。</string>
   </property>
  </action>
  <action name="actionRebootRecovery">
   <property name="icon">
    <iconset resource="resources.qrc">
     <normaloff>:/icons/icons/reboot_recovery.svg</normaloff>:/icons/icons/reboot_recovery.svg</iconset>
   </property>
   <property name="text">
    <string>重启到 Recovery（写 MISC 后重启）</string>
   </property>
   <property name="toolTip">
